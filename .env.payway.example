# PayWay (ABA Bank) Payment Gateway Configuration
# Get your credentials from: https://sandbox.payway.com.kh/register-sandbox/

# PayWay Merchant ID (provided by ABA Bank)
PAYWAY_MERCHANT_ID=

# PayWay API Key (provided by ABA Bank)
PAYWAY_API_KEY=

# PayWay Environment (sandbox or production)
PAYWAY_ENVIRONMENT=sandbox

# PayWay Base URL
# Sandbox: https://checkout-sandbox.payway.com.kh
# Production: https://checkout.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# PayWay Settings
PAYWAY_ENABLED=true
PAYWAY_DEFAULT_LIFETIME=30
PAYWAY_QR_TEMPLATE=template3_color
PAYWAY_LOG_REQUESTS=true
PAYWAY_LOG_RESPONSES=true

# Optional: Custom callback URL (leave empty to use default route)
PAYWAY_CALLBACK_URL=
